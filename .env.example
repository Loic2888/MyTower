# Copier ce fichier en .env et adapter si besoin. .env n'est jamais commité
# (voir .gitignore) — toutes les valeurs de config réelles vivent là,
# jamais en dur dans le code ou les fichiers versionnés (cf. CLAUDE.md,
# section "Configuration & sécurité").

# --- docker-compose.yml : ports exposés en local ---
OLLAMA_PORT=11434
QDRANT_PORT=6333
KOLIBRI_PORT=8080
KOLIBRI_ZIP_PORT=8081
PROTOMAPS_PORT=8090
KIWIX_PORT=8082

# --- Backend Tauri (src-tauri) : appel à Ollama pour le chat IA ---
# Voir docs/decisions/0002-llm-qwen3-4b.md pour le choix du modèle.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# La réflexion ("thinking") n'est plus pilotée ici : un bouton dans
# ChatPanel.svelte la bascule à la demande (désactivée par défaut, voir
# docs/decisions/0001-llm-qwen3-8b.md).

# --- Front (Svelte/Vite) : URL des outils embarqués dans ToolsPanel ---
# Doit être préfixé VITE_ pour être exposé au front (mécanisme Vite, distinct
# du .env chargé côté Rust). Doit rester cohérent avec KOLIBRI_PORT/KIWIX_PORT
# ci-dessus si tu les changes — ce sont des variables séparées.
VITE_KOLIBRI_URL=http://localhost:8080
VITE_KIWIX_URL=http://localhost:8082

# --- Backend Tauri : où écrire les fichiers .zim téléchargés par l'outil
# "Contenus" (docs/decisions/0003-kiwix-offline-wikipedia.md). Doit pointer
# sur le même dossier que le bind-mount kiwix dans docker-compose.yml.
KIWIX_DATA_DIR=./data/kiwix

# D'autres variables s'ajouteront ici au fil des étapes du séquencement —
# ne pas anticiper.
